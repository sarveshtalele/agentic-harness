{
  "name": "agentic-qe-harness",
  "version": "1.0.0",
  "description": "Microsoft Agent Framework (MAF) based Quality Engineering Chatbot & Multi-Agent Harness",
  "private": true,
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "build": "npm --prefix src/frontend run build",
    "start": "npm --prefix src/frontend run start",
    "lint": "npm --prefix src/frontend run lint",
    "test:unit": "python3 -m pytest tests/test_maf_backend.py tests/test_harness_universal_hitl.py tests/test_harness_project_scoped_features.py -v",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
