{
  "name": "agentic-qe-harness",
  "version": "1.0.0",
  "description": "Microsoft Agent Framework (MAF) based Quality Engineering Chatbot & Multi-Agent Harness",
  "private": true,
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "build": "npm --prefix src/frontend run build",
    "start": "npm --prefix src/frontend run start",
    "lint": "npm --prefix src/frontend run lint",
    "test:unit": "python3 -m pytest tests/test_maf_backend.py tests/test_harness_universal_hitl.py tests/test_harness_project_scoped_features.py -v",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.84.1",
    "@copilotkit/react-ui": "^1.84.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
