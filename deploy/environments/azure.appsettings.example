# AZURE environment (web profile): enter these as App Service "Environment variables" in the portal.
# Never put them in a file inside the zip. See docs/AZURE_DEPLOYMENT_GUIDE.md.

# --- Application settings ---
ATLAS_PROFILE=web
ATLAS_DATA_DIR=/home/atlas/data
ATLAS_ADMIN_USERNAME=
ATLAS_ADMIN_EMAIL=
# Secrets live in Key Vault, read at startup with the web app's managed identity (backend/keyvault.py):
#   atlas-admin-password -> ATLAS_ADMIN_PASSWORD, atlas-secret-key -> ATLAS_SECRET_KEY, atlas-database-url -> ATLAS_DATABASE_URL
ATLAS_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# Without a vault, set ATLAS_ADMIN_PASSWORD and ATLAS_SECRET_KEY here instead.
ATLAS_ALLOWED_HOSTS=
ATLAS_ALLOWED_ORIGINS=
ATLAS_MAX_SANDBOXES=5
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
# Optional: send traces to Application Insights (eastus2) through OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentic-qe-api

# --- API web app (built-in Python 3.12 image; startup command: python /home/site/wwwroot/startup.py) ---
WEBSITES_PORT=8000
WEBSITES_CONTAINER_START_TIME_LIMIT=900
SCM_DO_BUILD_DURING_DEPLOYMENT=false
ENABLE_ORYX_BUILD=false
# all (default) | none | comma list of node,java,maven,dotnet,go,chromium. Installed once into /home/tools in the background.
ATLAS_INSTALL_TOOLCHAINS=all

# --- UI web app (built-in Node 22 LTS image; startup command: node /home/site/wwwroot/startup.js) ---
# ATLAS_BACKEND_URL=https://aqe-api-<unique>.azurewebsites.net
# WEBSITES_PORT=3000, WEBSITES_ENABLE_APP_SERVICE_STORAGE=true, SCM_DO_BUILD_DURING_DEPLOYMENT=false, ENABLE_ORYX_BUILD=false
