# LOCAL environment: develop and test the whole project on your own machine.
# Copy to .env at the repository root (never commit it). Fully isolated from Azure: its own store, files and secrets.
ATLAS_PROFILE=local
ATLAS_DATA_DIR=data/local
# PostgreSQL: `python scripts/dev.py up` (or `db`) starts a local cluster in data/postgres and fills this in.
ATLAS_DATABASE_URL=

# Required: the first administrator. Use a password of 12+ characters that differs from the username.
ATLAS_ADMIN_USERNAME=
ATLAS_ADMIN_PASSWORD=
ATLAS_ADMIN_EMAIL=

# Optional: the model can also be set on the Settings page, which stores the key encrypted.
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEFAULT_MODEL=

# Harness limits: leave unset. The defaults (200 rounds, 400 tool calls per turn, a 30-minute turn budget) let a QE
# phase finish; this template once set 25 and 60, which cut every long harness turn short (found 2026-11-13).
# ATLAS_HARNESS_SHELL_TIMEOUT=600
ATLAS_LOG_RETENTION_DAYS=30
ATLAS_TRACE_RETENTION_DAYS=30
