{
  "name": "agentic-qe-desktop",
  "productName": "Agentic QE Platform",
  "version": "0.1.0",
  "description": "Agentic QE Platform desktop app: Electron shell around the local MAF backend and Next.js UI",
  "main": "main.js",
  "private": true,
  "author": "Agentic QE Platform",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.agenticqe.platform",
    "productName": "Agentic QE Platform",
    "artifactName": "agentic-qe-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "lib/**/*",
      "main.js",
      "package.json",
      "preload.js",
      "setup.html"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "build/ui",
        "to": "ui"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
