# Any OpenAI-compatible endpoint. Can also be set in the Settings page, which encrypts the key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Centralized Database & State Storage
# Database path resolves to: $ATLAS_DATA_DIR/atlas.sqlite3
ATLAS_DATA_DIR=./data
ATLAS_WORKSPACES=./data/projects

# SQLite Journal Mode: WAL (Write-Ahead Logging) enables non-blocking multi-agent reads.
# Set to DELETE only on network mounts (e.g. legacy SMB) lacking POSIX shared-memory primitives.
ATLAS_SQLITE_JOURNAL=WAL

# Cryptographic Secret Key for HMAC audit ledger signing and Fernet token encryption.
# Optional. If omitted, a key is generated automatically at data/.secret.key
# ATLAS_SECRET_KEY=

# Administrative Authentication (Required: backend refuses sign-ins without these)
ATLAS_ADMIN_USERNAME=
ATLAS_ADMIN_PASSWORD=
# Optional contact address of the admin account, shown beside admin approvals.
ATLAS_ADMIN_EMAIL=

# Session Security & Idle Lifecycles
# ATLAS_SESSION_HOURS=12
# ATLAS_SESSION_IDLE_MINUTES=480

# Defense-in-Depth Token Limits: Maximum tokens consumed per workflow run.
# Breaching this limit halts the run with AQE-ALLOW-001 (AllowanceError) to prevent runaway loops.
ATLAS_RUN_TOKEN_LIMIT=50000000

# Execution & Concurrency Controls
# Seconds before an LLM call times out (retried once automatically)
ATLAS_MODEL_TIMEOUT=180
# Max concurrent LLM calls across agents
ATLAS_MODEL_CONCURRENCY=4
# Maximum repository upload archive size in MB
ATLAS_MAX_UPLOAD_MB=200
# Maximum test cases designed per QE run
ATLAS_MAX_CASES=40

# Network & Host Protection
# ATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ATLAS_ALLOWED_HOSTS=

# Observability & Audit Logs
# Days to retain daily JSONL log files in $ATLAS_DATA_DIR/logs (app-YYYY-MM-DD.jsonl)
ATLAS_LOG_RETENTION_DAYS=30
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prompt Caching: Set to 1 to bypass proxy cache for fresh retries and evaluations
ATLAS_MODEL_NO_CACHE=1
